<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
  <world name="navis_prep">
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <physics name="default" type="ignored">
      <max_step_size>.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <scene>
      <ambient>.28 .32 .38 1</ambient>
      <background>.58 .73 .84 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1 .95 .85 1</diffuse>
      <specular>.5 .5 .5 1</specular>
      <direction>-.4 .3 -.8</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="ocean">
      <static>true</static>
      <pose>0 0 -.25 0 0 0</pose>
      <link name="base_link">
        <visual name="water">
          <pose>0 0 -.35 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://navis_ocean/meshes/waterlow.dae</uri>
              <scale>4 4 4</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>.025 .16 .24 1</ambient>
            <diffuse>.025 .16 .24 1</diffuse>
            <specular>.3 .35 .4 1</specular>
            <pbr>
              <metal>
                <metalness>.25</metalness>
                <roughness>.28</roughness>
                <normal_map>model://navis_ocean/materials/textures/wave_normals.dds</normal_map>
              </metal>
            </pbr>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
        <visual name="near_water">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://navis_ocean/meshes/near_ocean.obj</uri>
            </mesh>
          </geometry>
          <cast_shadows>false</cast_shadows>
          <plugin filename="libNavisWaveVisual.so" name="vrx::WaveVisual">
            <model_path>/project/ros_ws/src/navis_sim/models/navis_ocean/model.sdf</model_path>
            <shader>
              <vertex>materials/programs/GerstnerWaves_vs_330.glsl</vertex>
              <fragment>materials/programs/GerstnerWaves_fs_330.glsl</fragment>
              <parameters>
                <rescale>.18</rescale>
                <bumpScale>440 440</bumpScale>
                <hdrMultiplier>.48</hdrMultiplier>
                <fresnelPower>4</fresnelPower>
                <shallowColor>.018 .12 .15 1</shallowColor>
                <deepColor>.007 .037 .064 1</deepColor>
              </parameters>
            </shader>
            <wavefield>
              <topic>/navis/wavefield</topic>
              <wave>
                <model>CWR</model>
                <number>3</number>
                <amplitude>.055</amplitude>
                <period>5.5</period>
                <scale>1.4</scale>
                <angle>.45</angle>
                <steepness>.15</steepness>
                <direction>.6435</direction>
                <tau>2</tau>
              </wave>
            </wavefield>
          </plugin>
        </visual>
      </link>
    </model>
    <model name="SHIP-01">
      <static>true</static>
      <pose>0 0 2.4 0 0 0</pose>
      <link name="base_link">
        <sensor name="fleet_camera_wide" type="camera">
          <pose>-210 -270 337.6 0 0.7823886869288589 0.9097531579442097</pose>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <topic>/navis/camera/wide</topic>
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>.1</near>
              <far>1500</far>
            </clip>
          </camera>
        </sensor>
        <sensor name="fleet_camera_detail" type="camera">
          <pose>-110 -160 107.6 0 0.515444662011788 0.9685089806599324</pose>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <topic>/navis/camera/detail</topic>
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>.1</near>
              <far>1500</far>
            </clip>
          </camera>
        </sensor>
      </link>
      <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>SHIP-01/base_link</robot_base_frame>
        <odom_publish_frequency>5</odom_publish_frequency>
        <dimensions>3</dimensions>
        <odom_topic>/navis/SHIP_01/odometry</odom_topic>
      </plugin>
    </model>
