<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
  <world name="navis_prep">
    <physics name="default" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <scene>
      <ambient>.65 .65 .65 1</ambient>
      <background>.55 .72 .86 1</background>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="sea_surface">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>.025 .20 .32 1</ambient>
            <diffuse>.025 .20 .32 1</diffuse>
            <specular>.5 .65 .75 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="USV-01">
      <pose>0 0 .23 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>10</mass>
          <inertia>
            <ixx>1</ixx>
            <iyy>1</iyy>
            <izz>1</izz>
          </inertia>
        </inertial>
        <collision name="hull">
          <geometry>
            <box>
              <size>2.2 .85 .45</size>
            </box>
          </geometry>
        </collision>
        <visual name="hull">
          <geometry>
            <mesh>
              <uri>model://navis_vessels/meshes/usv.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.7 1</ambient>
            <diffuse>0.1 0.8 0.7 1</diffuse>
          </material>
        </visual>
        <sensor name="camera" type="camera">
          <pose>.55 0 1.15 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>/navis/camera</topic>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>200</far>
            </clip>
          </camera>
        </sensor>
        <visual name="deck">
          <pose>-.2 0 .3 0 0 0</pose>
          <geometry>
            <box>
              <size>.9 .6 .25</size>
            </box>
          </geometry>
          <material>
            <ambient>.85 .88 .90 1</ambient>
            <diffuse>.85 .88 .90 1</diffuse>
          </material>
        </visual>
        <visual name="sensor_mast">
          <pose>-.4 0 .7 0 0 0</pose>
          <geometry>
            <box>
              <size>.07 .07 .9</size>
            </box>
          </geometry>
          <material>
            <ambient>.2 .25 .3 1</ambient>
            <diffuse>.2 .25 .3 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_publish_frequency>10</odom_publish_frequency>
        <odom_topic>/navis/USV_01/odometry</odom_topic>
        <dimensions>3</dimensions>
      </plugin>
    </model>
    <model name="escort_ship">
      <static>true</static>
      <pose>15 0 .5 0 0 1.5707963267948966</pose>
      <link name="hull">
        <visual name="hull">
          <geometry>
            <mesh>
              <uri>model://navis_vessels/meshes/ship.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>.32 .38 .43 1</ambient>
            <diffuse>.32 .38 .43 1</diffuse>
          </material>
        </visual>
        <visual name="deck">
          <pose>-1 0 .85 0 0 0</pose>
          <geometry>
            <box>
              <size>10 3 .2</size>
            </box>
          </geometry>
          <material>
            <ambient>.55 .61 .65 1</ambient>
            <diffuse>.55 .61 .65 1</diffuse>
          </material>
        </visual>
        <visual name="superstructure">
          <pose>-1 0 1.8 0 0 0</pose>
          <geometry>
            <box>
              <size>4 2.1 1.8</size>
            </box>
          </geometry>
          <material>
            <ambient>.65 .69 .72 1</ambient>
            <diffuse>.65 .69 .72 1</diffuse>
          </material>
        </visual>
        <visual name="bridge">
          <pose>1 0 2.6 0 0 0</pose>
          <geometry>
            <box>
              <size>2.2 2.3 .9</size>
            </box>
          </geometry>
          <material>
            <ambient>.72 .76 .79 1</ambient>
            <diffuse>.72 .76 .79 1</diffuse>
          </material>
        </visual>
        <visual name="windows">
          <pose>1 0 2.8 0 0 0</pose>
          <geometry>
            <box>
              <size>2.23 2.33 .24</size>
            </box>
          </geometry>
          <material>
            <ambient>.05 .18 .26 1</ambient>
            <diffuse>.05 .18 .26 1</diffuse>
          </material>
        </visual>
        <visual name="mast">
          <pose>-1 0 4 0 0 0</pose>
          <geometry>
            <box>
              <size>.14 .14 3</size>
            </box>
          </geometry>
          <material>
            <ambient>.4 .46 .5 1</ambient>
            <diffuse>.4 .46 .5 1</diffuse>
          </material>
        </visual>
        <visual name="radar">
          <pose>-1 0 5.3 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 .14 .3</size>
            </box>
          </geometry>
          <material>
            <ambient>.6 .65 .68 1</ambient>
            <diffuse>.6 .65 .68 1</diffuse>
          </material>
        </visual>
        <collision name="flight_deck">
          <pose>-1 0 .85 0 0 0</pose>
          <geometry>
            <box>
              <size>10 3 .2</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <engine>ogre2</engine>
        <scene>scene</scene>
        <camera_pose>-14 -22 18 0 .5 .65</camera_pose>
        <ambient_light>.65 .65 .65</ambient_light>
        <background_color>.55 .72 .86</background_color>
      </plugin>
      <plugin filename="GzSceneManager" name="GzSceneManager" />
      <plugin filename="InteractiveViewControl" name="InteractiveViewControl" />
      <plugin filename="CameraTracking" name="CameraTracking" />
      <plugin filename="WorldControl" name="WorldControl" />
      <plugin filename="WorldStats" name="WorldStats" />
      <plugin filename="EntityTree" name="EntityTree" />
    </gui>
    <include>
      <uri>model://x3_uav</uri>
      <name>UAV-01</name>
      <pose>14.2 -5.2 1.65 0 0 0</pose>
      <plugin filename="ignition-gazebo-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>UAV-01</robotNamespace>
        <jointName>X3/rotor_0_joint</jointName>
        <linkName>X3/rotor_0</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <motorNumber>0</motorNumber>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
