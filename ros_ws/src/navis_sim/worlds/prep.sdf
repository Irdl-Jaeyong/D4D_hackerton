      <static>true</static>
      <pose>-85 -110 145 0 0.8064700758285163 0.9129077216126865</pose>
      <link name="base_link">
        <sensor name="fleet_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <topic>/navis/camera</topic>
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>.1</near>
              <far>1500</far>
            </clip>
          </camera>
        </sensor>
      </link>
