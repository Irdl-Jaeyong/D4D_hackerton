      <plugin filename="MinimalScene" name="3D View">
        <engine>ogre2</engine>
        <scene>scene</scene>
        <camera_pose>-85 -110 145 0 0.8064700758285163 0.9129077216126865</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="GzSceneManager" />
      <plugin filename="InteractiveViewControl" name="InteractiveViewControl" />
      <plugin filename="CameraTracking" name="CameraTracking" />
      <plugin filename="WorldControl" name="WorldControl" />
      <plugin filename="WorldStats" name="WorldStats" />
      <plugin filename="EntityTree" name="EntityTree" />
    </gui>
