# 백엔드가 사용할 설정. 모델 선정 후 OLLAMA_MODEL을 입력한다.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=minicpm-v4.5:latest

# 임의의 긴 문자열로 설정; 실제 값은 Git에 올리지 않는다.
NAVIS_BRIDGE_TOKEN=
NAVIS_ROS_IMAGE=aac-2026-image:sim

# Web and Gazebo bridges must use the same backend URL.
NAVIS_WEB_PORT=18083
NAVIS_BACKEND_URL=http://127.0.0.1:18083
IGN_PARTITION=navis-d4d
ROS_DOMAIN_ID=45

# Local text model for the separate AI response candidate
# Leave empty to use OLLAMA_MODEL.
AI_RESPONSE_MODEL=

# scripts/D4D_enter.sh
NAVIS_CONTAINER=d4d-enter-prep
NAVIS_BACKEND_UNIT=d4d-enter-koyul-web
NAVIS_SIM_UNIT=d4d-enter-koyul-sim
NAVIS_GUI_UNIT=d4d-enter-koyul-gui
NAVIS_OLLAMA_UNIT=d4d-enter-ollama
